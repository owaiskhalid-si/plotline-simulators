# Public URL of the deployment (used for canonical links and social cards)
NEXT_PUBLIC_SITE_URL=https://plotline.example.com

# Optional — shown in the header/footer when set
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_REPO_URL=

# Optional — switches on the "AI analyst" panel on every simulator. Server-only.
# Free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
